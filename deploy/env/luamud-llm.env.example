# Copy to /etc/luamud/llm.env (root-owned, mode 0640).
# Keep LUAMUD_LLM_ENABLED=false for an immediate rollback without code changes.
LUAMUD_LLM_ENABLED=false
# The command bridge does not expose /api/embeddings. Keep this false unless a separate compatible embedding backend is deployed.
LUAMUD_SEMANTIC_MATCH_ENABLED=false
LUAMUD_LLM_BRIDGE_URL=http://127.0.0.1:11435
LUAMUD_LLM_MODEL=openrouter-bridge
