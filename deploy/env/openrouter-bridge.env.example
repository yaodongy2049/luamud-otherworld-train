# Copy to /etc/luamud-openrouter-bridge/openrouter.env (root-owned, mode 0600).
# Never commit the copied file or place an API key in this repository.
OPENROUTER_API_KEY=

# The bridge must remain loopback-only.
LUAMUD_LLM_BRIDGE_HOST=127.0.0.1
LUAMUD_LLM_BRIDGE_PORT=11435
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# Fixed model allowlist of one. Change only through the server private file and review costs first.
LUAMUD_OPENROUTER_MODEL=qwen/qwen3-30b-a3b-instruct-2507
LUAMUD_LLM_TIMEOUT_SECONDS=25
LUAMUD_LLM_MAX_REQUEST_BYTES=12288
LUAMUD_LLM_MAX_INPUT_CHARS=6000
LUAMUD_LLM_MAX_OUTPUT_TOKENS=180
LUAMUD_LLM_DAILY_CALL_LIMIT=24
LUAMUD_LLM_STATE_FILE=/var/lib/luamud-openrouter-bridge/usage.json
